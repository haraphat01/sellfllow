# ─────────────────────────────────────────────────────────────────────────────
# SellFlow environment. Copy to .env.local and fill in. NEVER commit real values.
# Variables without NEXT_PUBLIC_ are server-only and must never reach the browser.
# ─────────────────────────────────────────────────────────────────────────────

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Shown on /privacy, /terms and /data-deletion (Meta App Review requires real contact details)
NEXT_PUBLIC_LEGAL_NAME="SellFlow"
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_COMPANY_ADDRESS=

# Supabase (Project Settings → API). Newer projects call these "publishable" and
# "secret" keys; either name works.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 32 random bytes, base64. Encrypts stored WhatsApp/Paystack credentials.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_ENCRYPTION_KEY=

# Meta / WhatsApp Cloud API (Phase 3) — see WHATSAPP.md
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_CONFIG_ID=
META_GRAPH_API_VERSION=v25.0
# Optional system-user token for development/testing only; production uses
# per-business tokens from Embedded Signup, stored encrypted.
WHATSAPP_ACCESS_TOKEN=

# Paystack — see PAYMENTS.md
# SellFlow's OWN Paystack account, used only to bill merchants for their SellFlow
# subscription (Phase 10). Merchants' customer payments use each merchant's key,
# entered in Settings → Payments. Webhook for this account: /api/webhooks/paystack/billing
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# AI via Vercel AI Gateway (Phase 5) — see AI.md
# AI_PROVIDER_API_KEY is accepted as an alias.
AI_GATEWAY_API_KEY=
# Platform default model for businesses that don't pick one, e.g. deepseek/deepseek-flash
AI_DEFAULT_MODEL=anthropic/claude-sonnet-5
# Optional: DeepSeek directly (select a "deepseek/…" model in Settings → AI assistant)
DEEPSEEK_API_KEY=

# Inngest background jobs. Locally: INNGEST_DEV=1 + `npm run inngest:dev`.
# Production: the Vercel Inngest integration sets the keys.
INNGEST_DEV=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Observability
SENTRY_DSN=
